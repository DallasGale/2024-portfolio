---
import { Image } from "astro:assets";
import DallasLogoWhite from "../../images/dallas-white.png";
import DallasLogoBlack from "../../images/dallas-black.png";
import ThemeCube from "@components/themeCube";
import Logo from "@components/logo/index.astro";
import MobileMenu from "@components/mobileMenu";
---

<header class="header">
  <div class="content">
    <Logo />
    <span style="visibility: hidden">Dallas Gale. creative</span>
    <!-- <ThemeCube client:load /> -->
    <MobileMenu client:load />
  </div>
</header>

<style lang="scss">
  @import "../../scss/breakpoints.scss";
  .header {
    position: fixed;

    padding: var(--space-5);
    z-index: 20;
    height: 110px;
    width: 100%;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    @include respond-to(phone-up) {
      // backdrop-filter: none;
      // -webkit-backdrop-filter: none;
    }
    @include respond-to(desktop-up) {
      left: 0;
      right: 0;
    }
  }

  .content {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    @include respond-to(desktop-up) {
      max-width: 1400px;
      margin-inline: auto;
    }
  }
</style>

---
import { Image } from "astro:assets";
import DallasLogoWhite from "../../images/dallas-white.png";
import DallasLogoBlack from "../../images/dallas-black.png";
import ThemeCube from "@components/themeCube";
import Logo from "@components/logo/index.astro";
import MobileMenu from "@components/mobileMenu";
---

<header class="header">
  <div class="content">
    <div class="logo-container">
      <Logo />
      <span class="visually-hidden">Dallas Gale. creative</span>
    </div>
    <!-- <ThemeCube client:load /> -->
    <MobileMenu client:load />
  </div>
</header>

<style lang="scss">
  @import "../../scss/breakpoints.scss";
  .header {
    position: fixed;
    max-width: 1600px;
    margin-inline: auto;
    // padding: var(--space-5);
    z-index: 20;
    height: 110px;
    top: 30px;
    width: 100%;
    height: auto;
    left: 0;
    right: 0;
    padding: 0 var(--space-5);

    @include respond-to(desktop-up) {
      max-width: 95vw;
    }
  }

  .content {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    @include respond-to(desktop-up) {
      max-width: 98vw;
      margin-inline: auto;
    }
  }

  .logo-container {
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    border-radius: 10px;
    width: 120px;
    z-index: 2;
  }
</style>

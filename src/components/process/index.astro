---
import Title from "./title.astro";
import Parallax from "./parallax";
import FloatingElement from "@components/floatingElement";
---

<section id="process" class="section">
  <div class="title-container" id="process-title">
    <FloatingElement duration={4} client:load>
      <Title />
    </FloatingElement>
    <h2 class="visually-hidden">Projects</h2>
  </div>
  <Parallax client:load />
</section>

<script>
  import { ToggleTitle } from "../../utils/toggleTitle";
  document.addEventListener("DOMContentLoaded", () => {
    new ToggleTitle("process", "process-title");
  });
</script>

<style lang="scss">
  @import "../../scss/breakpoints.scss";
  .section {
    height: 4000px;
    position: relative;
    // max-width: 600px;
    margin-inline: auto;
    @include respond-to(tablet-up) {
      // height: auto;
      // max-width: 1440px;
    }
  }

  .title {
    position: sticky;
    top: 90px;
    height: 80px;
  }
</style>

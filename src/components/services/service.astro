---
import SecondaryCta from "@components/secondaryCta";
import PrimaryCta from "../primaryCta/index.astro";

interface Props {
  title: string;
  description: string;
  id: number;
  dotPoints: string[];
}
let { id, title, description, dotPoints }: Props = Astro.props;
---

<div id={`service-${id}`} class="service">
  <div class="content-wrapper content-bg">
    <h3 class="display3">{title}<span class="accent">.</span></h3>
    <p class="paragraph" set:html={description} />
    <ul class="ul">
      {dotPoints.map((point, index) => <li class="li paragraph">{point}</li>)}
    </ul>

    <div class="cta-wrapper">
      <SecondaryCta
        icon
        label={`Contact me about ${title}`}
        onClick={() => null}
      />
    </div>
  </div>
</div>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cta-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .ul {
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .li {
    position: relative;
    list-style: none;
    padding-left: 30px;
    &:before {
      position: absolute;
      left: 0;
      content: "👉";
      margin-right: var(--space-2);
    }
  }

  .content-wrapper {
    gap: 20px;
    display: flex;
    flex-direction: column;
  }
</style>

---
import SignatureWhite from "@images/dallas-white.png";
---

<section class="container">
  <div class="text-wrap">
    <h2 class="display2 one">
      Based in the Yarra Valley, Australia, I bring over a decade of experience
      crafting digital experiences at <span>leading agencies</span>, <span
        >ABC News</span
      >, <span>innovative startups</span>
      and through <span>freelance projects</span>, I now offer specialised web
      design and development services to turn your vision into reality.
      <img src={SignatureWhite.src} alt="Dallas" class="signature" />
    </h2>
  </div>

  <style lang="scss">
    @import "../../scss/breakpoints.scss";
    @import "../../scss/animations.scss";

    .container {
      z-index: 2;
      margin-bottom: var(--space-9);
      padding: var(--space-5);
      margin-inline: auto;
      height: 100vh;
      @include respond-to(tablet-up) {
        max-width: 950px;
      }
    }

    .text-wrap {
      position: sticky;
      top: 30%;
    }
    h2 {
      text-align: center;
      // &.one {
      //   animation: float 86s infinite ease-in-out forwards;
      // }
      // &.two {
      //   animation: float 46s infinite ease-in-out forwards;
      // }
    }
    span {
      font-weight: 600;
      color: var(--color-primary);
    }

    .signature {
      width: 120px;
      position: absolute;
      right: var(--space-5);
      @include respond-to(tablet-up) {
        width: 180px;
        bottom: -100px;
        // left: var(--space-7);
        // right: auto;
      }
    }
  </style>
</section>

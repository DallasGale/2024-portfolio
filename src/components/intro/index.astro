  <style lang="scss">
    @import "../../scss/breakpoints.scss";
    @import "../../scss/animations.scss";

    .container {
      z-index: 2;
      margin-bottom: var(--space-9);
      padding: 30vh var(--space-5) var(--space-5) var(--space-5);
      margin-inline: auto;
      height: 80vh;
      @include respond-to(tablet-up) {
        max-width: 1440px;
        display: flex;
        align-items: center;
      }
    }

    .text-wrap {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      max-width: 940px;
      margin-inline: auto;
      // top: 30%;
    }
    h2 {
      text-align: center;
    }
    span {
      // font-weight: 600;
      color: var(--color-accent);
    }

    .signature {

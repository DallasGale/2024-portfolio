---
import Bg from "../../images/smoke-hero.jpg";
import { Image } from "astro:assets";
import HeroText from "./heroText.astro";
import BallContainer from "./ballContainer.astro";
import FloatingElement from "@components/floatingElement";
import PlusText from "./plusText.astro";
---

<script is:inline>
  function heroParallax() {
    const img = document.querySelector("#hero-image");
    if (img) {
      const pos = window.scrollY * 0.025;
      img.style.transform = `translateY(${pos}px) translateX(${pos}px)`;
      img.style.opacity = 1 - window.scrollY / 30000;
    } else {
      console.log("no image found");
    }
  }

  function workParallax() {
    const el = document.querySelector(".heroTextContainer");
    const pos = window.scrollY * -0.2;
    el.style.transform = `translateY(${pos}px)`;
  }

  document.addEventListener("scroll", () => {
    heroParallax();
    workParallax();
  });
</script>
<section class="section">
  <div class="heroContainer">
    <div class="heroTextContainer">
      <FloatingElement duration={30} client:load>
        <HeroText />
        <!-- <div class="plusTextContainer">
          <PlusText />
        </div> -->
      </FloatingElement>
    </div>
    <h1 class="visually-hidden">web dev + design</h1>

    <BallContainer />
  </div>
  <div id="hero-image" class="bgImageContainer">
    <Image
      src={Bg}
      class="bgImage"
      alt="descriptive text"
      width={2000}
      height={1333}
      quality="max"
      style="opacity: 0.4"
    />
  </div>
</section>

<style lang="scss">
  @import "../../scss/animations.scss";
  @import "../../scss/breakpoints.scss";

  .section {
    display: grid;
    height: 120vh;
    align-items: flex-start;
    justify-items: center;
    z-index: 0;
    padding-left: var(--space-5);
    padding-right: var(--space-5);
  }

  .heroContainer {
    display: flex;
    overflow: hidden;
    height: 100dvh;
    width: 100%;
    // animation: float 86s infinite ease-in-out forwards;
  }

  .bgImageContainer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    mix-blend-mode: exclusion;
    z-index: 0;
    opacity: 0.7;
  }
  .bgImage {
    animation: smoke 25s ease-in-out infinite forwards;
    position: absolute;
    right: 0;
    bottom: 80px;
    pointer-events: none;
    object-fit: fill;
    display: flex;
    min-width: 2000px;
    width: 100%;

    // @include respond-to(desktop-up) {
    //   bottom: 140px;
    // }
    @include respond-to(desktop-up) {
      bottom: 500px;
      min-width: 2800px;
    }
  }

  .heroTextContainer {
    max-width: 1100px;
    position: absolute;
    top: 30vh;
    left: 0;
    right: 0;
    margin-inline: auto;
    display: block;
  }

  @keyframes pulse {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
    100% {
      opacity: 1;
    }
  }
  .plusTextContainer {
    animation: pulse 3s infinite ease-in-out;
    position: absolute;
    top: 45vw;
    left: 60px;
    width: 10vw;
  }
</style>

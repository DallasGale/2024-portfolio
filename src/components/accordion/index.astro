---
type Project = {
  id: number;
  title: string;
  description: string;
  image?: string;
  url?: string;
};

interface Props {
  projects: Project[];
}
const { projects }: Props = Astro.props;
---

<script>
  import { Accordion } from "../../utils/accordion";

  // init accordions
  const accordions = document.querySelectorAll<HTMLElement>(".accordion h3");
  accordions.forEach((accordionEl) => {
    new Accordion(accordionEl as HTMLElement);
  });
</script>
<div id="accordionGroup" class="accordion">
  {
    projects.map(({ id, title, description }: Project) => {
      return (
        <>
          <h3>
            <button
              type="button"
              aria-expanded="false"
              class="accordion-trigger"
              aria-controls={`sect${id}`}
              id={`accordion${id}id`}
            >
              <span class="accordion-title">
                {title}
                <span class="accordion-icon" />
              </span>
            </button>
          </h3>
          <div
            id={`sect${id}`}
            role="region"
            hidden
            aria-labelledby={`accordion${id}id`}
            class="accordion-panel"
          >
            <p>{description}</p>
          </div>
        </>
      );
    })
  }
</div>

<style lang="scss">
  .accordion {
    margin: 0;
    padding: 0;
    border-radius: 7px;
    width: 100%;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .accordion h3 {
    margin: 0;
    padding: 0;
  }

  .accordion-trigger {
    background: none;
    border-bottom: 2px solid var(--color-accent);
    display: block;
    font-size: 1rem;
    font-weight: normal;
    margin: 0;
    padding: 0 var(--space-5);
    position: relative;
    border-radius: 0;
    text-align: left;
    width: 100%;
    outline: none;
    height: 90px;
  }

  .accordion-trigger:focus,
  .accordion-trigger:hover {
    // background: hsl(216deg 94% 94%);
  }

  .accordion-trigger:focus {
    outline: 4px solid transparent;
  }

  button {
    border-style: none;
  }

  p {
    color: var(--color-primary-text);
  }

  .accordion button::-moz-focus-inner {
    border: 0;
  }

  .accordion-title {
    display: block;
    pointer-events: none;
    border: transparent 2px solid;
    border-radius: 5px;
    padding: 0.25em;
    outline: none;
    color: var(--color-primary-text);
    font-weight: 600;
    font-size: 18px;
  }

  .accordion-trigger:focus .accordion-title {
    border-color: var(--color-primary);
  }

  .accordion-icon {
    border: solid currentcolor;
    border-width: 0 2px 2px 0;
    height: 0.5rem;
    pointer-events: none;
    position: absolute;
    right: 2em;
    top: 50%;
    transform: translateY(-60%) rotate(45deg);
    width: 0.5rem;
  }

  .accordion-trigger[aria-expanded="true"] .accordion-icon {
    transform: translateY(-50%) rotate(-135deg);
  }

  .accordion-panel {
    margin: 0;
    padding: 1em 1.5em;
  }

  /* For Edge bug https://developer.microsoft.com/en-us/microsoft-edge/platform/issues/4806035/ */
  .accordion-panel[hidden] {
    display: none;
  }
</style>

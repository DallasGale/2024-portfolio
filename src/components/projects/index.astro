---
import Accordion from "@components/accordion/index.astro";
import Title from "./title.astro";
import FloatingElement from "@components/floatingElement";
import ProjectList from "./projectList";
import { data } from "./data";
---

<section class="section" id="projects">
  <div class="title-container" id="projects-title">
    <FloatingElement duration={4} client:load>
      <Title />
    </FloatingElement>
    <h2 class="visually-hidden">Projects</h2>
  </div>

  <div class="container">
    <div class="carousel-container">
      <ProjectList client:load projects={data} />
    </div>
    <!-- <div class="accordion-container">
      <Accordion projects={data} />
    </div> -->
  </div>
</section>

<style lang="scss">
  @import "../../scss/breakpoints.scss";

  .section {
    display: flex;
    flex-direction: column;
    position: relative;
    margin-bottom: var(--space-9);
    height: auto;
    @include respond-to(phone-up) {
      // height: auto;
      padding-top: 20vh;
    }
  }

  .accordion-container {
    @include respond-to(phone-up) {
      display: none;
    }
  }
  .carousel-container {
    // overflow: hidden;
    @include respond-to(phone-up) {
      display: block;
      height: 100%;
    }
  }

  .sticky-container {
    position: sticky;
    top: 100px;
    height: auto;
    max-width: 600px;
    margin-inline: auto;
    @include respond-to(tablet-up) {
      margin-inline: 0;
      max-width: 100%;
    }
  }
</style>
<script>
  import { ToggleTitle } from "../../utils/toggleTitle";
  document.addEventListener("DOMContentLoaded", () => {
    new ToggleTitle("projects", "projects-title");
  });
</script>
